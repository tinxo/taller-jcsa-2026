{
  "name": "taller-api",
  "main": "src/worker.py",
  "compatibility_date": "2026-08-27",
  // URL pública *.workers.dev (es la que va en VITE_API_URL del front)
  "workers_dev": true,
  // Si Wrangler se queja de este flag (ya obsoleto tras la GA), borralo.
  "compatibility_flags": ["python_workers"],
  // Logs del Worker: se ven en Cloudflare (Workers > taller-api > Observability) y con `npx wrangler tail taller-api`
  "observability": {
    "logs": { "enabled": true }
  },
  "vars": {
    // Reemplazá TU-INSTANCIA por el dominio de tu app en Clerk (Frontend API URL)
    "CLERK_ISSUER": "https://guiding-redbird-725.clerk.accounts.dev",
    "CLERK_JWKS_URL": "https://guiding-redbird-725.clerk.accounts.dev/.well-known/jwks.json",
    "MAIL_FROM": "onboarding@resend.dev"
  }
  // Secretos (no van acá): NEON_CONNECTION_STRING y RESEND_API_KEY
  // -> uv run pywrangler secret put NEON_CONNECTION_STRING
}
